# База
DATABASE_URL=postgresql://protokol:protokol@localhost:5432/protokol
# Публичный адрес (для QR и .ics)
APP_URL=http://localhost:3000
# Пароли тестовых аккаунтов (только для сида; в репо — не класть реальные значения)
SEED_PASSWORD_ALISA=
SEED_PASSWORD_TIMUR=
SEED_PASSWORD_VERA=
SEED_PASSWORD_IRINA=
# Демо-режим для жюри (06-seed-data): кнопки «Войти как…» на /login без пароля. 1 — включить
DEMO_MODE=
# ИИ-помощник (опционально; без ключа — режим FAQ)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# faq — принудительно без ИИ (так работают e2e); пусто — GigaChat, если задан ключ
ASSISTANT_PROVIDER=
# TLS GigaChat подписан «Russian Trusted Root CA» (certs/). Node читает переменную только при старте процесса;
# в Docker-образе она уже задана. Локально: NODE_EXTRA_CA_CERTS=certs/russian_trusted_root_ca.pem
NODE_EXTRA_CA_CERTS=
# Прод (docker-compose.prod.yml). DATABASE_URL для app собирается из POSTGRES_* автоматически.
# Домен: на старте <ip-через-дефисы>.sslip.io, например 203-0-113-7.sslip.io
DOMAIN=
POSTGRES_USER=protokol
POSTGRES_PASSWORD=
POSTGRES_DB=protokol
# Тег образа из GHCR: latest или короткий sha коммита (sha-abc1234)
TAG=latest
# Тег образа с инструментами (миграции, пересев демо): tools или tools-<sha>
TOOLS_TAG=tools
