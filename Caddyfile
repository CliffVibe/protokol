# HTTPS через Let's Encrypt автоматически. DOMAIN — из .env (например 203-0-113-7.sslip.io).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# X-Forwarded-For = адрес соединения, явно: по нему приложение считает блокировку входа «логин + IP»
	# (src/lib/client-ip.ts). Присланный клиентом заголовок не продолжаем — иначе его можно подделать.
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
